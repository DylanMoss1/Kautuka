package main

var x int
var y bool
var z string 

var a int = 1
var b bool = true 
var c string = "Hello world"

func main() {

    i := 1
    for i <= 3 {
        print(i)
        i = i + 1
    }

    for j := 7; j <= 9; j++ {
        print(j)
    }

    for {
        print("loop")
        break
    }

    for n := 0; n <= 5; n++ {
        if n == 0 {
            continue
        }
        print(n)
    }
}

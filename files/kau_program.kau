package main

var x int
var y bool
var z string 

var a int = 1
var b bool = true 
var c string = "Hello world"

func main() {

    
    for i := 1; i <= 3; i++ {
        print(i)
    }

    for j := 7; j <= 9; j++ {
        print(j)
    }

    for n := 0; n <= 5; n++ {
        if n == 0 {
            continue
        }
        print(n)
    }
}

package main

func main() {
	var file1_contents string
	var file2_contents string
	var file3_contents string
	var file4_contents string
	var file5_contents string
	var file6_contents string
	var file7_contents string

	{
		file1 := open("./benchmark/files/large1.txt")
		file1_contents = read(file1, 50000)
	}

	{
		file2 := open("./benchmark/files/large2.txt")
		file2_contents = read(file2, 50000)
	}

	{
		file3 := open("./benchmark/files/large3.txt")
		file3_contents = read(file3, 50000)
	}

	{
		file4 := open("./benchmark/files/large4.txt")
		file4_contents = read(file4, 50000)
	}

	{
		file5 := open("./benchmark/files/large5.txt")
		file5_contents = read(file5, 50000)
	}

	{
		file6 := open("./benchmark/files/large6.txt")
		file6_contents = read(file6, 50000)
	}

	{
		file7 := open("./benchmark/files/large7.txt")
		file7_contents = read(file7, 50000)
	}

	print(file1_contents + file2_contents + file3_contents + file4_contents + file5_contents + file6_contents + file7_contents)

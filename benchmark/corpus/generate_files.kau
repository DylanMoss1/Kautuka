package main

func main() {
	file1 := open("./benchmark/files/tmp/small1.txt", 1)
	file2 := open("./benchmark/files/tmp/small2.txt", 1)
	file3 := open("./benchmark/files/tmp/small3.txt", 1)

	contents1 := read(open("./benchmark/files/tmp/tmp1.txt"), 350000)
	contents2 := read(open("./benchmark/files/tmp/tmp2.txt"), 350000)
	contents3 := read(open("./benchmark/files/tmp/tmp3.txt"), 350000)

	{
		write(file1, contents1)
	}

	{
		write(file2, contents2)
	}

	{
		write(file3, contents3)
	}
}

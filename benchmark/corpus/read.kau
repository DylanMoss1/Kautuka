package main

func main() {
	var file1_contents string
	var file2_contents string
	var file3_contents string
	var file4_contents string
	var file5_contents string

	{
		file1 := open("./benchmark/files/read1.txt")
		file1_contents = read(file1, 20000)
	}

	{
		file2 := open("./benchmark/files/read2.txt")
		file2_contents = read(file2, 20000)
	}

	{
		file3 := open("./benchmark/files/read3.txt")
		file3_contents = read(file3, 20000)
	}

	{
		file4 := open("./benchmark/files/read4.txt")
		file4_contents = read(file4, 20000)
	}

	{
		file5 := open("./benchmark/files/read5.txt")
		file5_contents = read(file5, 20000)
	}

	_ = file1_contents + file2_contents + file3_contents + file4_contents + file5_contents
}

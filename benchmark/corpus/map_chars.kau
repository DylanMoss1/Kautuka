package main

func map_chars(contents string, from string, to string) string { 

	result := ""

	for char := range contents { 
		if char != from {
			result += char
		} else { 
			result += to 
		}
	}

	return result 
}

func main() {
	var result1 string
	var result2 string
	var result3 string

	file1 := read(open("./benchmark/files/very_small1.txt", 1), 20000)
	file2 := read(open("./benchmark/files/very_small2.txt", 1), 20000)
	file3 := read(open("./benchmark/files/very_small2.txt", 1), 20000)

	{
		result1 = map_chars(file1, "a", "b")
	}
	{
		result2 = map_chars(file2, "c", "d")
	}
	{
		result3 = map_chars(file3, "e", "f")
	}

	print(result1)
	print(result2)
	print(result3)
}
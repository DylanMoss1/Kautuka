package main

func seperate_characters(str string) string {

	result := ""

	for s := range str {
		result += s
		result += " "
	}

	return result
}

func main() {

	var result1 string
	var result2 string
	var result3 string

	{
		result1 = seperate_characters(read(open("./benchmark/files/very_small1.txt", 1), 20000))
	}
	{
		result2 = seperate_characters(read(open("./benchmark/files/very_small2.txt", 1), 20000))
	}
	{
		result3 = seperate_characters(read(open("./benchmark/files/very_small3.txt", 1), 20000))
	}

	print(result1)
	print(result2)
	print(result3)
}

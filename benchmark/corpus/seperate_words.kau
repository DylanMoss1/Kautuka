package main

func seperate_characters(str string) string {

	result := ""

	for s := range str {
		result += s
		result += " "
	}

	return result
}

func main() {

	var result1 string
	var result2 string

	file1 := read(open("./benchmark/files/very_small1.txt", 1), 20000)
	file2 := read(open("./benchmark/files/very_small2.txt", 1), 20000)

	{
		result1 = seperate_characters(file1)
	}
	{
		result2 = seperate_characters(file2)
	}

	print(result1)
	print(result2)
}

package main

func parse(contents string) string { 

	result := ""

	for char := range contents { 
		if char != " " {
			result += char
		}
	}

	return result 
}

func main() {
	var file1_contents string
	var file2_contents string
	var file3_contents string
	var file4_contents string
	var file5_contents string

	{
		file1 := open("./benchmark/files/small1.txt", 1)
		file1_contents = parse(read(file1, 50000))
	}

	{
		file2 := open("./benchmark/files/small2.txt", 1)
		file2_contents = parse(read(file2, 50000))
	}

	{
		file3 := open("./benchmark/files/small3.txt", 1)
		file3_contents = parse(read(file3, 50000))
	}

	{
		file4 := open("./benchmark/files/small4.txt", 1)
		file4_contents = parse(read(file4, 50000))
	}

	{
		file5 := open("./benchmark/files/small5.txt", 1)
		file5_contents = parse(read(file5, 50000)) 
	}

	print(file1_contents + file2_contents + file3_contents + file4_contents + file5_contents)
}
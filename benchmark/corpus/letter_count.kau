package main

func letter_count(contents string) int {
	total := 0

	for s := range contents {
		if s != " " {
			total += 1
		}
	}

	return total
}

func main() {

	var file1_count int
	var file2_count int
	var file3_count int

	{
		file1_count = letter_count(read(open("./benchmark/files/large1.txt", 1), 20000))
	}

	{
		file2_count = letter_count(read(open("./benchmark/files/large2.txt", 1), 20000))
	}

	{
		file3_count = letter_count(read(open("./benchmark/files/large3.txt", 1), 20000))
	}


	print(file1_count + file2_count + file3_count)
}

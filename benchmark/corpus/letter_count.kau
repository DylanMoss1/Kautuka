package main

func get_count_from_contents(contents string) int {
	total := 0

	for s := range contents {
		total += 1
	}

	return total
}

func letter_count(filename string) int {
	contents := read(open(filename), 20000)
	return get_count_from_contents(contents)
}

func main() {

	var file1_count int
	var file2_count int
	var file3_count int
	var file4_count int
	var file5_count int

	{
		file1_count = letter_count("./files/read1.txt")
	}

	{
		file2_count = letter_count("./files/read2.txt")
	}

	{
		file3_count = letter_count("./files/read3.txt")
	}

	{
		file4_count = letter_count("./files/read4.txt")
	}

	{
		file5_count = letter_count("./files/read5.txt")
	}

	_ = file1_count + file2_count + file3_count + file4_count + file5_count
}

package main 

func count_letter(str string, letter string) { 

	count := 0 

	for s := range str { 
		if s == letter { 
			count += 1 
		}
	}

	return count 
}

func main() { 
	file := open("./files/read1.txt")
	contents := read(file, 20000)

	var a_count int
	var e_count int 
	var i_count int 
	var o_count int 
	var u_count int 

	{
		a_count = count_letter(contents, "a")
	}
	{
		e_count = count_letter(contents, "e")
	}
	{
		i_count = count_letter(contents, "i")
	}
	{
		o_count = count_letter(contents, "o")
	}
	{
		u_count = count_letter(contents, "u")
	}

	_ = a_count + e_count + i_count + o_count + u_count
}
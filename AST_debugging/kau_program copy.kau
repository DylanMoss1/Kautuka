package main

func sum_first_1000_nums() int { 
	total := 0 

	for i := 0; i < 1000; i++ { 
		total += i 	
	}

	return total
}

func main() {
	a := 0
	b := 0
	c := 0 
	d := 0
	{ 
		a = sum_first_1000_nums() 
	}
	{ 
		b = sum_first_1000_nums() 
	}
	{
		c = sum_first_1000_nums()
	}
	{
		d = sum_first_1000_nums()
	}
	print(a + b + c + d)
}
